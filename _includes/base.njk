<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "The Founder's Errata" }}</title>
<style>
  body {
    font-family: Georgia, "Times New Roman", Times, serif;
    max-width: 42.5em;
    margin: 3em auto;
    padding: 0 1em;
    color: #111;
    background: #fff;
    line-height: 1.65;
  }
  a { color: #000; }
  a:hover { text-decoration: none; }
  h1, h2, h3 { font-weight: normal; line-height: 1.3; }
  h1 { font-size: 1.5em; margin-top: 0; }
  h1 .bi { color: #666; font-size: 0.85em; }
  h2 { font-size: 1.15em; margin-top: 2em; }
  h3 { font-size: 1em; font-style: italic; }
  p { margin: 0.9em 0; }
  hr { border: 0; border-top: 1px solid #ddd; margin: 2.2em 0; }
  ol.entries { list-style: none; padding: 0; margin: 2.2em 0; }
  ol.entries li {
    margin: 0.55em 0;
    display: grid;
    grid-template-columns: 3.5em 6.5em 1fr;
    gap: 0.6em;
    align-items: baseline;
  }
  ol.entries .id { color: #666; font-variant-numeric: tabular-nums; }
  time { color: #666; font-variant-numeric: tabular-nums; }
  nav { margin-bottom: 1.8em; font-size: 0.9em; }
  article header { margin-bottom: 1.5em; color: #555; font-size: 0.95em; }
  p.back { margin-top: 3em; padding-top: 1.2em; border-top: 1px solid #ddd; font-size: 0.9em; }
  @media (max-width: 32em) {
    ol.entries li { grid-template-columns: auto auto; grid-template-rows: auto auto; }
    ol.entries li a { grid-column: 1 / -1; }
  }
</style>
</head>
<body>
{% block content %}{% endblock %}
</body>
</html>
